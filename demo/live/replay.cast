[1.131579, "o", "  pattern: attitude_loss <- rw0_friction+rw1_torque_derate   minimized in 11 sims\r\n  faults : rw0 friction sev 0.2 @ 105s; rw1 torque_derate sev 1.0 @ 505s;  beta 65.0 deg\r\n"]
